\newlabel{tab:nine}{{4}{5}{The best model and the SEIR-GNN against their controls. Three-origin rows pair 9 (origin, seed) runs; nine-origin rows pair the 9 disjoint origins (seeds averaged), the unit a claim about the series rests on (attainable $p$ floor 0.004). Raw two-sided $p$.\relax }{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Six encoders behind three heads (Table\nonbreakingspace \ref {tab:encoders}). The direct head separates encoders that work from encoders that fail; the SEIR decoder is worse than persistence on all of them; the gated SEIR head puts all six at the same level, below persistence (dashed) on validation and test.\relax }}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:encoders}{{1}{5}{Six encoders behind three heads (Table~\ref {tab:encoders}). The direct head separates encoders that work from encoders that fail; the SEIR decoder is worse than persistence on all of them; the gated SEIR head puts all six at the same level, below persistence (dashed) on validation and test.\relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Anchor, gate or physics? Each encoder behind four heads that add, in turn, the persistence anchor, the learned gate and the SEIR simulator (mean validation RMSE; configuration of Table\nonbreakingspace \ref {tab:encoders}). The last two columns pair the gated SEIR head with its no-physics twin (\texttt  {gated}); negative favours the physics, and the count is runs where it wins.\relax }}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:rescue}{{5}{5}{Anchor, gate or physics? Each encoder behind four heads that add, in turn, the persistence anchor, the learned gate and the SEIR simulator (mean validation RMSE; configuration of Table~\ref {tab:encoders}). The last two columns pair the gated SEIR head with its no-physics twin (\texttt {gated}); negative favours the physics, and the count is runs where it wins.\relax }{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Every lever's validation delta against its own control (Table\nonbreakingspace \ref {tab:levers}); win counts on the right. Green: negative and $\ge $7/9 wins. Grey: negative but inconsistent. Red: worse.\relax }}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:levers}{{2}{6}{Every lever's validation delta against its own control (Table~\ref {tab:levers}); win counts on the right. Green: negative and $\ge $7/9 wins. Grey: negative but inconsistent. Red: worse.\relax }{figure.caption.10}{}}
