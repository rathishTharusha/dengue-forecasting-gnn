\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces PAGE{}. An unchanged encoder reads the last $W$ weeks of standardised log cases on the district graph. Its read-out $\mathbf  {u}_i$ is turned into a departure $\boldsymbol  {\delta }_i=\mathbf  {u}_i-p_i\mathbf  {1}$ from the persistence anchor, shrunk by a learned gate, and added back to the anchor. The dashed SEIR branch replaces the read-out with a differentiable simulator; it is the component the ablation removes.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{2}{\model {}. An unchanged encoder reads the last $W$ weeks of standardised log cases on the district graph. Its read-out $\mathbf {u}_i$ is turned into a departure $\boldsymbol {\delta }_i=\mathbf {u}_i-p_i\mathbf {1}$ from the persistence anchor, shrunk by a learned gate, and added back to the anchor. The dashed SEIR branch replaces the read-out with a differentiable simulator; it is the component the ablation removes}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Ablation: from the published direct head to PAGE{}. Each encoder behind four heads that add, in turn, the persistence anchor (residual), the learned gate (PAGE{}) and the SEIR branch (mean validation RMSE; configuration of Table~\ref {tab:encoders}). The last two columns pair PAGE{}+SEIR with PAGE{}; negative favours the SEIR branch, and the count is runs where it wins.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:rescue}{{II}{2}{Ablation: from the published direct head to \model {}. Each encoder behind four heads that add, in turn, the persistence anchor (residual), the learned gate (\model {}) and the SEIR branch (mean validation RMSE; configuration of Table~\ref {tab:encoders}). The last two columns pair \model {}+SEIR with \model {}; negative favours the SEIR branch, and the count is runs where it wins}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Prospective evaluation on weeks no model or setting had seen: 85 forecast starts, 2024-W11 to 2026-W32. Settings frozen on development data before the new weeks were parsed. Neural arms: mean over 3 seeds, seed range of RMSE in brackets. Bold: best per metric. Pre-registered tests (block bootstrap over forecast starts, Holm over two): P1, SEIR branch vs PAGE{}: $-0.03$ $[-0.41, +0.12]$, $p_{\text  {Holm}}=0.67$; P2, PAGE{}+SEIR vs persistence: $+0.65$ $[-0.99, +1.69]$, $p_{\text  {Holm}}=0.62$.}}{3}{table.3}\protected@file@percent }
\newlabel{tab:prospective}{{III}{3}{Prospective evaluation on weeks no model or setting had seen: 85 forecast starts, 2024-W11 to 2026-W32. Settings frozen on development data before the new weeks were parsed. Neural arms: mean over 3 seeds, seed range of RMSE in brackets. Bold: best per metric. Pre-registered tests (block bootstrap over forecast starts, Holm over two): P1, SEIR branch vs \model {}: $-0.03$ $[-0.41, +0.12]$, $p_{\text {Holm}}=0.67$; P2, \model {}+SEIR vs persistence: $+0.65$ $[-0.99, +1.69]$, $p_{\text {Holm}}=0.62$}{table.3}{}}
