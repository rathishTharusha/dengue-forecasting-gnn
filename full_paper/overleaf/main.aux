\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Six encoders behind three heads (Table\nonbreakingspace \ref {tab:encoders}). The direct head separates encoders that work from encoders that fail; the SEIR decoder fails on all of them; the gated SEIR head puts all six at the same level, below persistence (dashed) on validation and test.\relax }}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:encoders}{{1}{4}{Six encoders behind three heads (Table~\ref {tab:encoders}). The direct head separates encoders that work from encoders that fail; the SEIR decoder fails on all of them; the gated SEIR head puts all six at the same level, below persistence (dashed) on validation and test.\relax }{figure.caption.9}{}}
