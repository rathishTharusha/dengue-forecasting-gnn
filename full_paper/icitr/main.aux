\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Ablation: from the published direct head to PAGE{}. Each encoder behind four heads that add, in turn, the persistence anchor (residual), the learned gate (PAGE{}) and the SEIR branch (mean validation RMSE; configuration of Table~\ref {tab:encoders}). The last two columns pair PAGE{}+SEIR with PAGE{}; negative favours the SEIR branch, and the count is runs where it wins.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:rescue}{{II}{4}{Ablation: from the published direct head to \model {}. Each encoder behind four heads that add, in turn, the persistence anchor (residual), the learned gate (\model {}) and the SEIR branch (mean validation RMSE; configuration of Table~\ref {tab:encoders}). The last two columns pair \model {}+SEIR with \model {}; negative favours the SEIR branch, and the count is runs where it wins}{table.2}{}}
