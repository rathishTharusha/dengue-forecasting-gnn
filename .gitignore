# Third-party papers (copyrighted — do not redistribute)
papers/

# Reference implementation cloned from MLOpenSourceOpenScience/disease_modeling_MLOS2
# Read-only cross-check material; belongs to its original authors.
reference_repo/

# Course handout (not ours to publish)
CS3631 - Project - 2026.pdf

# Raw multi-source dump (3.5 MB, superseded by the processed .npy we track).
# See docs/DATA.md for how to obtain it.
datasets/

# Byte-identical duplicate of "Literature Review - GNN for Dengue Forecasting.md".
# Kept locally; only the "Literature Review - ..." copy is tracked.
GNN for Dengue Forecasting.md

# Session/scratch transcripts
*chathistory*.txt
scratch/
scratchpad/

# Kaggle staging area — copies of tracked data plus generated metadata.
# Rebuild with scripts/kaggle_run.py. Never put kaggle.json here.
kaggle/
!kaggle/.gitkeep

# Generated Overleaf bundle — rebuild with scripts/make_overleaf.py.
# Committing it would create a second copy of the paper that drifts from paper/.
overleaf/
overleaf.zip

