\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Every lever, paired against its own control on matched (origin, seed) runs. $\Delta $ is validation RMSE (negative is better); wins count the 9 units where the arm is better; $p_{\text  {adj}}$ is BH across this table. Test $\Delta $ is shown and decided nothing. With three origins these $p$-values describe run-to-run stability, not the series (\S  \ref {sec:protocol}).}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:levers}{{3}{5}{Every lever, paired against its own control on matched (origin, seed) runs. $\Delta $ is validation RMSE (negative is better); wins count the 9 units where the arm is better; $p_{\text {adj}}$ is BH across this table. Test $\Delta $ is shown and decided nothing. With three origins these $p$-values describe run-to-run stability, not the series (\S \ref {sec:protocol})}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces The best model and the SEIR-GNN against their controls. Three-origin rows pair 9 (origin, seed) runs; nine-origin rows pair the 9 disjoint origins (seeds averaged), the unit a claim about the series rests on (attainable $p$ floor 0.004). Raw two-sided $p$.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:nine}{{4}{6}{The best model and the SEIR-GNN against their controls. Three-origin rows pair 9 (origin, seed) runs; nine-origin rows pair the 9 disjoint origins (seeds averaged), the unit a claim about the series rests on (attainable $p$ floor 0.004). Raw two-sided $p$}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Ablation: from the published direct head to PAGE{}. Each encoder behind four heads that add, in turn, the persistence anchor (residual), the learned gate (PAGE{}) and the SEIR branch (mean validation RMSE; configuration of Table\nonbreakingspace \ref {tab:encoders}). The last two columns pair PAGE{}+SEIR with PAGE{}; negative favours the SEIR branch, and the count is runs where it wins.}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:rescue}{{5}{6}{Ablation: from the published direct head to \model {}. Each encoder behind four heads that add, in turn, the persistence anchor (residual), the learned gate (\model {}) and the SEIR branch (mean validation RMSE; configuration of Table~\ref {tab:encoders}). The last two columns pair \model {}+SEIR with \model {}; negative favours the SEIR branch, and the count is runs where it wins}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces PAGE{} against the published direct head and against persistence, on matched (origin, seed) runs of Table\nonbreakingspace \ref {tab:encoders}. Mean RMSE difference (negative favours PAGE{}) and wins out of 9. $^{*}$: $p_{\text  {adj}}<0.05$, exact sign-flip test, BH across the table (attainable floor 0.004).}}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:paired}{{6}{6}{\model {} against the published direct head and against persistence, on matched (origin, seed) runs of Table~\ref {tab:encoders}. Mean RMSE difference (negative favours \model {}) and wins out of 9. $^{*}$: $p_{\text {adj}}<0.05$, exact sign-flip test, BH across the table (attainable floor 0.004)}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Hyperparameter tuning: mean validation RMSE over the nine purged development origins $\times $ 3 seeds (108 runs per arm). Bold: the setting each arm selects. The same grid and budget are given to every learned arm; test data play no part. AR(3) ridge, by $\alpha $: 0.01: 27.64, 0.1: 27.64, 1: 27.64, 10: 27.65, 100: 27.76.}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:tuning}{{7}{6}{Hyperparameter tuning: mean validation RMSE over the nine purged development origins $\times $ 3 seeds (108 runs per arm). Bold: the setting each arm selects. The same grid and budget are given to every learned arm; test data play no part. AR(3) ridge, by $\alpha $: 0.01: 27.64, 0.1: 27.64, 1: 27.64, 10: 27.65, 100: 27.76}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Computational cost. Parameters of the full model behind the direct head, and the parameters each head adds. Seconds per epoch and seconds per training run (with early stopping) are means over the 9 runs of the Kaggle run, each run single-threaded on a 4-core Kaggle CPU. PAGE{} adds one parameter and no measurable time; the SEIR branch adds five parameters and about $2\times $ the time per epoch on the light encoders.}}{6}{table.caption.12}\protected@file@percent }
\newlabel{tab:compute}{{8}{6}{Computational cost. Parameters of the full model behind the direct head, and the parameters each head adds. Seconds per epoch and seconds per training run (with early stopping) are means over the 9 runs of the Kaggle run, each run single-threaded on a 4-core Kaggle CPU. \model {} adds one parameter and no measurable time; the SEIR branch adds five parameters and about $2\times $ the time per epoch on the light encoders}{table.caption.12}{}}
